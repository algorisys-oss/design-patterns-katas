---

service [class] "Service" { methods: "getUser(id)" }
repo [interface] "UserRepository" { methods: "find(id);save(u)" }
sql [class] "SqlUserRepository" { methods: "find(id);save(u)" }
mem [class] "InMemoryUserRepository" { methods: "find(id);save(u)" }

service -> repo "uses"
repo --> sql { startArrowhead: triangle, endArrowhead: none }
repo --> mem { startArrowhead: triangle, endArrowhead: none }
