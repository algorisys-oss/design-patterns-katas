component [class] "Component"
concrete [class] "ConcreteComponent"
decorator [class] "Decorator"
da [class] "ConcreteDecorator A"
db [class] "ConcreteDecorator B"

concrete -> component "implements"
decorator -> component "implements + wraps"
da -> decorator "extends"
db -> decorator "extends"
