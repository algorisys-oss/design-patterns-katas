---
title: Decorator — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

component [interface] "Component" { methods: "read()" }
concrete [class] "ConcreteComponent" { methods: "read()" }
decorator [class] "Decorator" { attributes: "-inner: Component", methods: "read()" }

component --> concrete { startArrowhead: triangle, endArrowhead: none }
component --> decorator { startArrowhead: triangle, endArrowhead: none }
decorator -> component "wraps" { startArrowhead: diamond, endArrowhead: none }
