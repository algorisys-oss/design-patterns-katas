---
title: Composite — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

component [interface] "Component" { methods: "size()" }
leaf [class] "File" { methods: "size()" }
composite [class] "Folder" { attributes: "-children: Component[]", methods: "size();add(c)" }

component --> leaf { startArrowhead: triangle, endArrowhead: none }
component --> composite { startArrowhead: triangle, endArrowhead: none }
composite -> component "children" { startArrowhead: diamond, endArrowhead: none }
