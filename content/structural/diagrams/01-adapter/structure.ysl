client [class] "Client" { methods: "pay(dollars)" }
target [interface] "Target" { methods: "pay(dollars)" }
adapter [class] "Adapter" { attributes: "-adaptee: Adaptee", methods: "pay(dollars)" }
adaptee [class] "Adaptee" { methods: "charge(cents)" }

client -> target "uses"
target --> adapter { startArrowhead: triangle, endArrowhead: none }
adapter -> adaptee "adaptee"
