---
title: Facade — Structure
layout: tree-down
hSpacing: 55
vSpacing: 150
---

client [class] "Client" { methods: "order()" }
facade [class] "OrderFacade" { methods: "placeOrder(cart)" }
inventory [class] "Inventory" { methods: "reserve(items)" }
payment [class] "Payment" { methods: "charge(total)" }
shipping [class] "Shipping" { methods: "dispatch(order)" }

client -> facade "uses"
facade --> inventory
facade --> payment
facade --> shipping
