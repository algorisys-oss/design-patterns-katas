---
title: Proxy — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

subject [interface] "Subject" { methods: "display()" }
real [class] "HighResImage" { methods: "display()" }
proxy [class] "ImageProxy" { attributes: "-real: HighResImage", methods: "display()" }

subject --> real { startArrowhead: triangle, endArrowhead: none }
subject --> proxy { startArrowhead: triangle, endArrowhead: none }
proxy -> real "real" { startArrowhead: diamond, endArrowhead: none }
