---
title: Factory Method — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

factory [class] "CacheFactory" { methods: "create(kind)" }
product [interface] "Cache" { methods: "get(k);set(k, v)" }
inmem [class] "InMemoryCache" { methods: "get(k);set(k, v)" }
disk [class] "DiskCache" { methods: "get(k);set(k, v)" }

factory --> product "creates"
product --> inmem { startArrowhead: triangle, endArrowhead: none }
product --> disk { startArrowhead: triangle, endArrowhead: none }
