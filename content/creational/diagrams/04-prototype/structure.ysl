---
title: Prototype — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

client [class] "Client" { methods: "spawn(p)" }
prototype [interface] "Prototype" { methods: "clone()" }
concrete1 [class] "Enemy" { attributes: "-stats", methods: "clone()" }
concrete2 [class] "Document" { attributes: "-blocks", methods: "clone()" }

client --> prototype "clone()"
prototype --> concrete1 { startArrowhead: triangle, endArrowhead: none }
prototype --> concrete2 { startArrowhead: triangle, endArrowhead: none }
