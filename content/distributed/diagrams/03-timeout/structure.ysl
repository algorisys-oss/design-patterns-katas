---

client [class] "Client" { methods: "run()" }
timeout [class] "Timeout" { attributes: "-deadline", methods: "within(op)" }
service [class] "Remote Service" { methods: "handle()" }
timer [class] "Timer" { methods: "after(ms)" }

client -> timeout "call"
timeout -> service "attempt"
timeout -> timer "race"
