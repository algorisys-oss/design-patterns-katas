---

client [class] "Client" { methods: "call()" }
breaker [class] "Circuit Breaker" { attributes: "-state: closed|open|half-open;-failures" }
service [class] "Remote Service" { methods: "handle()" }

client -> breaker "call"
breaker -> service "forward if closed"
