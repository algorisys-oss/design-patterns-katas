provider [class] "Provider" { attributes: "-value" }
a [class] "Consumer A" { methods: "use(value)" }
b [class] "Consumer B" { methods: "use(value)" }
c [class] "Consumer C" { methods: "use(value)" }

provider -> a "provides"
provider -> b
provider -> c
