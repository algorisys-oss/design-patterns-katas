---
title: Command — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

invoker [class] "Invoker" { attributes: "-history", methods: "invoke(cmd);undo()" }
command [interface] "Command" { methods: "execute();undo()" }
concmd [class] "ConcreteCommand" { attributes: "-receiver: Receiver", methods: "execute();undo()" }
receiver [class] "Receiver" { methods: "action()" }

invoker -> command "commands" { startArrowhead: diamond, endArrowhead: none }
command --> concmd { startArrowhead: triangle, endArrowhead: none }
concmd -> receiver "receiver"
