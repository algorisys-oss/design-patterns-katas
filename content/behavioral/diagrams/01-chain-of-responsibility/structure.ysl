---
title: Chain of Responsibility — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

client [class] "Client" { methods: "start(request)" }
handler [interface] "Handler" { attributes: "-next: Handler", methods: "setNext(h);handle(request)" }
ha [class] "ConcreteHandlerA" { methods: "handle(request)" }
hb [class] "ConcreteHandlerB" { methods: "handle(request)" }

client -> handler "sends"
handler --> ha { startArrowhead: triangle, endArrowhead: none }
handler --> hb { startArrowhead: triangle, endArrowhead: none }
