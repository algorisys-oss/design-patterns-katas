---
title: Memento — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

originator [class] "Originator" { attributes: "-state", methods: "save() Memento;restore(m)" }
caretaker [class] "Caretaker" { attributes: "-history: Memento[]", methods: "backup();undo()" }
memento [class] "Memento" { attributes: "-state", methods: "getState()" }

originator --> memento "creates"
caretaker -> memento "history" { startArrowhead: diamond, endArrowhead: none }
