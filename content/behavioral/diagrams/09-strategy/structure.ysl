---
title: Strategy — Structure
layout: tree-down
hSpacing: 60
vSpacing: 150
---

context [class] "Context" { attributes: "-strategy: Strategy", methods: "setStrategy(s);execute(amount)" }
strategy [interface] "Strategy" { methods: "pay(amount)" }
cc [class] "CreditCard" { methods: "pay(amount)" }
pp [class] "PayPal" { methods: "pay(amount)" }
cr [class] "Crypto" { methods: "pay(amount)" }

context -> strategy "strategy" { startArrowhead: diamond, endArrowhead: none }
strategy --> cc { startArrowhead: triangle, endArrowhead: none }
strategy --> pp { startArrowhead: triangle, endArrowhead: none }
strategy --> cr { startArrowhead: triangle, endArrowhead: none }
