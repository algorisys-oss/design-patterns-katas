---
title: Iterator — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

aggregate [interface] "Aggregate" { methods: "createIterator()" }
concagg [class] "ConcreteAggregate" { attributes: "-items", methods: "createIterator()" }
iterator [interface] "Iterator" { methods: "next();hasNext()" }
conciter [class] "ConcreteIterator" { attributes: "-index", methods: "next();hasNext()" }

aggregate --> concagg { startArrowhead: triangle, endArrowhead: none }
iterator --> conciter { startArrowhead: triangle, endArrowhead: none }
concagg --> conciter "creates"
