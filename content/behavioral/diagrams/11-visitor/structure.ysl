---
title: Visitor — Structure
layout: tree-down
hSpacing: 55
vSpacing: 140
---

element [interface] "Element" { methods: "accept(visitor)" }
circle [class] "Circle" { methods: "accept(visitor)" }
square [class] "Square" { methods: "accept(visitor)" }
visitor [interface] "Visitor" { methods: "visitCircle(c);visitSquare(s)" }
area [class] "AreaVisitor" { methods: "visitCircle(c);visitSquare(s)" }
svg [class] "SvgVisitor" { methods: "visitCircle(c);visitSquare(s)" }

element --> circle { startArrowhead: triangle, endArrowhead: none }
element --> square { startArrowhead: triangle, endArrowhead: none }
element --> visitor "accept(v)"
visitor --> area { startArrowhead: triangle, endArrowhead: none }
visitor --> svg { startArrowhead: triangle, endArrowhead: none }
