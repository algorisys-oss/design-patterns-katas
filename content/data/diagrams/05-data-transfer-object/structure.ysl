---

service [class] "Service" { methods: "getUser(id)" }
dto [class] "UserDTO" { attributes: "-id;-name;-email" }
client [class] "Client / API" { methods: "render()" }

service -> dto "assembles (no behavior)"
dto -> client "sent across boundary"
