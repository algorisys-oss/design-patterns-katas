---

pod [class] "Pod" { attributes: "-shared net/volume" }
app [class] "App Container" { methods: "serve()" }
sidecar [class] "Sidecar Container" { methods: "proxy/log/tls" }

pod -> app "main"
pod -> sidecar "attached"
app -> sidecar "via localhost"
