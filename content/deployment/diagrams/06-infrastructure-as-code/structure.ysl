code [class] "IaC Code" { attributes: "-desired state", methods: "plan();apply()" }
provisioner [class] "Provisioner" { methods: "reconcile()" }
infra [class] "Infrastructure" { attributes: "-actual state" }

code -> provisioner "desired state"
provisioner -> infra "create / update / destroy"
