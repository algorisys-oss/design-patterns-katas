---

task [class] "Task"
gen [class] "Generator" { methods: "draft();revise()" }
critic [class] "Critic" { methods: "critique(draft)" }
final [class] "Final"

task -> gen
gen -> critic "draft"
critic -> gen "feedback (loop)"
critic -> final "pass"
