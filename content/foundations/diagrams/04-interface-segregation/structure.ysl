---
title: Interface Segregation — Structure
layout: tree-down
hSpacing: 80
vSpacing: 150
---

workable [interface] "Workable" { methods: "work()" }
eatable [interface] "Eatable" { methods: "eat()" }
robot [class] "Robot" { methods: "work()" }
human [class] "Human" { methods: "work();eat()" }

workable --> robot { startArrowhead: triangle, endArrowhead: none }
workable --> human { startArrowhead: triangle, endArrowhead: none }
eatable --> human { startArrowhead: triangle, endArrowhead: none }
