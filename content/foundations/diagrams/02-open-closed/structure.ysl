---
title: Open/Closed — Structure
layout: tree-down
hSpacing: 60
vSpacing: 150
---

calc [class] "AreaCalculator" { methods: "total(shapes)" }
shape [interface] "Shape" { methods: "area()" }
circle [class] "Circle" { methods: "area()" }
square [class] "Square" { methods: "area()" }
triangle [class] "Triangle" { methods: "area()" }

calc --> shape "depends on"
shape --> circle { startArrowhead: triangle, endArrowhead: none }
shape --> square { startArrowhead: triangle, endArrowhead: none }
shape --> triangle { startArrowhead: triangle, endArrowhead: none }
