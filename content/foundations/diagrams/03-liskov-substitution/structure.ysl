---
title: Liskov Substitution — Structure
layout: tree-down
hSpacing: 70
vSpacing: 150
---

client [class] "Client" { methods: "use(shape)" }
shape [interface] "Shape" { methods: "area()" }
rect [class] "Rectangle" { methods: "area()" }
square [class] "Square" { methods: "area()" }

client --> shape "uses"
shape --> rect { startArrowhead: triangle, endArrowhead: none }
shape --> square { startArrowhead: triangle, endArrowhead: none }
