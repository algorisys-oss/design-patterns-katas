---
title: Single Responsibility — Structure
layout: tree-down
hSpacing: 55
vSpacing: 150
---

employee [class] "Employee" { attributes: "-name;-salary" }
pay [class] "PayCalculator" { methods: "calculate(emp)" }
repo [class] "EmployeeRepository" { methods: "save(emp)" }
report [class] "ReportFormatter" { methods: "format(emp)" }

employee -> pay
employee -> repo
employee -> report
